{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "memento-memory",
            "tool": "get_core_context",
            "input": {}
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "memento-memory",
            "tool": "log_message",
            "input": {
              "message": "${prompt}",
              "role": "user",
              "session_id": "${session_id}"
            }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "memento-memory",
            "tool": "log_message",
            "input": {
              "message": "${last_assistant_message}",
              "role": "assistant",
              "session_id": "${session_id}"
            }
          }
        ]
      }
    ]
  }
}
