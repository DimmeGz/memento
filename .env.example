# Root environment for memento (copy to `.env`). Loaded via `MEMENTO_ENV_ROOT` + memento_core.load_memento_env().
# DATABASE_URL is required for MCP and consolidator.

DATABASE_URL=

# --- Consolidator + Qdrant + Ollama (required for `memento-consolidator`)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION_PREFIX=facts

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CONSOLIDATION_MODEL=
OLLAMA_EMBEDDING_MODEL=

# Optional consolidator tuning
CONSOLIDATOR_DEDUP_THRESHOLD=0.97
CONSOLIDATOR_BATCH_SIZE=10
CONSOLIDATOR_STALE_MINUTES=30
CONSOLIDATOR_DEFAULT_IMPORTANCE=0.7
CONSOLIDATOR_DEFAULT_DECAY_RATE=0.01
# CONSOLIDATOR_TRANSCRIPT_MAX_CHARS=120000
